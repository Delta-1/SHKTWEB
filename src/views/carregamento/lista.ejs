<%- include('../partials/topo') %>

<div class="grade grade-3 mb-2">
  <div class="indicador destaque">
    <div class="rotulo">Expedido no período</div>
    <div class="valor"><%= f.toneladas(totais.expedido_kg) %></div>
    <div class="apoio"><%= totais.expedidos %> carregamento(s)</div>
  </div>
  <div class="indicador <%= Number(totais.em_aberto) ? 'atencao' : '' %>">
    <div class="rotulo">Em aberto</div>
    <div class="valor"><%= totais.em_aberto %></div>
    <div class="apoio">programados ou em carregamento</div>
  </div>
  <div class="indicador">
    <div class="rotulo">No filtro atual</div>
    <div class="valor"><%= lista.length %></div>
    <div class="apoio">ordem(ns) de carregamento</div>
  </div>
</div>

<div class="cartao">
  <div class="cartao-topo">
    <h2>Ordens de carregamento</h2>
    <span style="flex:1"></span>
    <% if (pode('carregamento.criar')) { %>
      <a href="/carregamentos/novo" class="btn primario pequeno">+ Nova ordem</a>
    <% } %>
  </div>

  <form method="get" class="filtros">
    <div class="campo largo">
      <label for="busca">Buscar</label>
      <input type="search" id="busca" name="busca" value="<%= filtros.busca || '' %>"
             placeholder="Nº, placa ou destino">
    </div>
    <div class="campo">
      <label for="status">Situação</label>
      <select id="status" name="status">
        <option value="">Todas</option>
        <% for (const s of ['RASCUNHO','PROGRAMADO','EM_CARREGAMENTO','EXPEDIDO','CANCELADO']) { %>
          <option value="<%= s %>" <%= filtros.status === s ? 'selected' : '' %>><%= f.rotuloStatus(s) %></option>
        <% } %>
      </select>
    </div>
    <div class="campo">
      <label for="cliente">Cliente</label>
      <select id="cliente" name="cliente">
        <option value="">Todos</option>
        <% for (const c of ref.clientes) { %>
          <option value="<%= c.id %>" <%= String(filtros.clienteId) === String(c.id) ? 'selected' : '' %>><%= c.nome %></option>
        <% } %>
      </select>
    </div>
    <div class="campo"><label for="de">De</label>
      <input type="date" id="de" name="de" value="<%= filtros.de || '' %>"></div>
    <div class="campo"><label for="ate">Até</label>
      <input type="date" id="ate" name="ate" value="<%= filtros.ate || '' %>"></div>
    <span class="espaco"></span>
    <button type="submit" class="btn">Filtrar</button>
    <a href="/carregamentos" class="btn">Limpar</a>
  </form>

  <% if (!lista.length) { %>
    <div class="vazio">
      <span class="icone">⇥</span>
      <p>Nenhum carregamento encontrado.</p>
      <% if (pode('carregamento.criar')) { %>
        <a href="/carregamentos/novo" class="btn primario">Criar ordem de carregamento</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="tabela-area">
      <table class="tabela responsiva">
        <thead>
          <tr>
            <th>Nº</th><th>Data</th><th>Cliente</th><th>Produto</th>
            <th>Veículo</th><th>Destino</th><th class="num">Quantidade</th>
            <th>Certificado</th><th>Situação</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const c of lista) { %>
            <tr class="<%= c.status === 'CANCELADO' ? 'linha-cancelada' : '' %>">
              <td data-rot="Nº" class="doc"><a href="/carregamentos/<%= c.id %>"><%= c.numero %></a></td>
              <td data-rot="Data" class="nowrap"><%= f.data(c.data) %></td>
              <td data-rot="Cliente"><%= c.cliente || '—' %></td>
              <td data-rot="Produto"><%= c.produto %>
                <div class="txt-min txt-fraco"><%= c.local %></div></td>
              <td data-rot="Veículo" class="mono txt-min"><%= c.placa || c.veiculo_placa || '—' %>
                <% if (c.motorista) { %><div class="txt-fraco"><%= c.motorista %></div><% } %></td>
              <td data-rot="Destino"><%= c.destino || '—' %></td>
              <td data-rot="Quantidade" class="num txt-forte"><%= f.toneladas(c.quantidade_kg) %></td>
              <td data-rot="Certificado" class="doc txt-min">
                <% if (c.certificado_numero) { %>
                  <a href="/certificados/<%= c.certificado_id %>"><%= c.certificado_externo || c.certificado_numero %></a>
                <% } else { %><span class="txt-fraco">—</span><% } %>
              </td>
              <td data-rot="Situação">
                <span class="pill <%= f.classeStatus(c.status) %>"><%= f.rotuloStatus(c.status) %></span>
              </td>
              <td class="acoes"><a href="/carregamentos/<%= c.id %>" class="btn pequeno">Abrir</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/fim') %>
