<%- include('partials/topo') %>

<div class="cartao">
  <div class="cartao-topo">
    <h2>Auditoria</h2>
    <span class="sub">Registro imutável de todas as ações críticas do sistema.</span>
  </div>

  <form method="get" class="filtros">
    <div class="campo largo">
      <label for="busca">Buscar</label>
      <input type="search" id="busca" name="busca" value="<%= filtros.busca || '' %>"
             placeholder="Descrição ou número do documento">
    </div>
    <div class="campo">
      <label for="modulo">Módulo</label>
      <select id="modulo" name="modulo">
        <option value="">Todos</option>
        <% for (const m of modulos) { %>
          <option value="<%= m.codigo %>" <%= filtros.modulo === m.codigo ? 'selected' : '' %>><%= m.nome %></option>
        <% } %>
      </select>
    </div>
    <div class="campo">
      <label for="acao">Ação</label>
      <select id="acao" name="acao">
        <option value="">Todas</option>
        <% for (const a of acoes) { %>
          <option value="<%= a %>" <%= filtros.acao === a ? 'selected' : '' %>><%= a %></option>
        <% } %>
      </select>
    </div>
    <div class="campo">
      <label for="usuario">Usuário</label>
      <select id="usuario" name="usuario">
        <option value="">Todos</option>
        <% for (const u of usuarios) { %>
          <option value="<%= u.id %>" <%= String(filtros.usuario) === String(u.id) ? 'selected' : '' %>><%= u.nome %></option>
        <% } %>
      </select>
    </div>
    <div class="campo"><label for="de">De</label>
      <input type="date" id="de" name="de" value="<%= filtros.de || '' %>"></div>
    <div class="campo"><label for="ate">Até</label>
      <input type="date" id="ate" name="ate" value="<%= filtros.ate || '' %>"></div>
    <span class="espaco"></span>
    <button type="submit" class="btn">Filtrar</button>
    <a href="/auditoria" class="btn">Limpar</a>
  </form>

  <% if (!registros.length) { %>
    <div class="vazio"><p>Nenhum registro de auditoria para os filtros escolhidos.</p></div>
  <% } else { %>
    <div class="tabela-area">
      <table class="tabela responsiva">
        <thead>
          <tr><th>Data/hora</th><th>Usuário</th><th>Módulo</th><th>Ação</th>
            <th>Documento</th><th>Descrição</th><th>Alterações</th></tr>
        </thead>
        <tbody>
          <% for (const r of registros) { %>
            <tr>
              <td data-rot="Data/hora" class="nowrap txt-min"><%= f.dataHora(r.data_hora) %></td>
              <td data-rot="Usuário"><%= r.usuario_nome || '—' %>
                <% if (r.ip) { %><div class="txt-min txt-fraco mono"><%= r.ip %></div><% } %>
              </td>
              <td data-rot="Módulo" class="txt-min"><%= r.modulo %></td>
              <td data-rot="Ação">
                <span class="pill <%= ['CANCELAR','ESTORNAR','LOGIN_FALHOU'].includes(r.acao) ? 'erro'
                                    : ['VALIDAR','APROVAR','EXPEDIR','PAGAR','RECEBER'].includes(r.acao) ? 'ok'
                                    : 'neutro' %>"><%= r.acao %></span>
              </td>
              <td data-rot="Documento" class="doc"><%= r.registro_numero || '—' %></td>
              <td data-rot="Descrição"><%= r.descricao || '' %></td>
              <td data-rot="Alterações">
                <% if (r.valor_anterior || r.valor_posterior) { %>
                  <details>
                    <summary class="txt-min" style="cursor:pointer">ver</summary>
                    <div class="txt-min mono" style="max-width:420px;overflow:auto">
                      <% const antes = r.valor_anterior || {}; const depois = r.valor_posterior || {}; %>
                      <% for (const chave of Object.keys(depois)) { %>
                        <div>
                          <strong><%= chave %>:</strong>
                          <span class="txt-erro"><%= JSON.stringify(antes[chave] ?? null) %></span>
                          →
                          <span class="txt-ok"><%= JSON.stringify(depois[chave]) %></span>
                        </div>
                      <% } %>
                    </div>
                  </details>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <div class="cartao-topo" style="border-bottom:none;border-top:1px solid var(--linha)">
      <span class="sub"><%= registros.length %> registro(s). Use os filtros para refinar.</span>
    </div>
  <% } %>
</div>

<%- include('partials/fim') %>
