<%- include('../partials/topo') %>

<% const ehPagar = tipo === 'CP'; %>

<div class="grade grade-3 mb-2">
  <div class="indicador">
    <div class="rotulo">Total no filtro</div>
    <div class="valor">R$ <%= f.formatar(totais.total, 2) %></div>
    <div class="apoio"><%= lista.length %> título(s)</div>
  </div>
  <div class="indicador destaque">
    <div class="rotulo">Saldo em aberto</div>
    <div class="valor">R$ <%= f.formatar(totais.saldo, 2) %></div>
    <div class="apoio">ainda não <%= ehPagar ? 'pago' : 'recebido' %></div>
  </div>
  <div class="indicador <%= totais.qtdVencidos ? 'alerta' : '' %>">
    <div class="rotulo">Vencido</div>
    <div class="valor">R$ <%= f.formatar(totais.vencido, 2) %></div>
    <div class="apoio"><%= totais.qtdVencidos %> título(s) em atraso</div>
  </div>
</div>

<div class="cartao">
  <div class="cartao-topo">
    <h2><%= titulo %></h2>
    <span style="flex:1"></span>
    <% if (pode('financeiro.criar')) { %>
      <a href="/financeiro/<%= segmento %>/novo" class="btn primario pequeno">+ Novo título</a>
    <% } %>
  </div>

  <form method="get" class="filtros">
    <div class="campo largo">
      <label for="busca">Buscar</label>
      <input type="search" id="busca" name="busca" value="<%= filtros.busca || '' %>"
             placeholder="Nº, descrição ou documento de origem">
    </div>
    <div class="campo">
      <label for="status">Situação</label>
      <select id="status" name="status">
        <option value="">Todas</option>
        <% for (const s of ehPagar ? ['ABERTO','PARCIAL','PAGO','CANCELADO'] : ['ABERTO','PARCIAL','RECEBIDO','CANCELADO']) { %>
          <option value="<%= s %>" <%= filtros.status === s ? 'selected' : '' %>><%= f.rotuloStatus(s) %></option>
        <% } %>
      </select>
    </div>
    <div class="campo">
      <label for="parceiro"><%= ehPagar ? 'Fornecedor' : 'Cliente' %></label>
      <select id="parceiro" name="parceiro">
        <option value="">Todos</option>
        <% for (const p of (ehPagar ? ref.fornecedores : ref.clientes) || []) { %>
          <option value="<%= p.id %>" <%= String(filtros.parceiroId) === String(p.id) ? 'selected' : '' %>><%= p.nome %></option>
        <% } %>
      </select>
    </div>
    <div class="campo"><label for="de">Vence de</label>
      <input type="date" id="de" name="de" value="<%= filtros.de || '' %>"></div>
    <div class="campo"><label for="ate">até</label>
      <input type="date" id="ate" name="ate" value="<%= filtros.ate || '' %>"></div>
    <div class="campo">
      <label for="vencidos">Atraso</label>
      <select id="vencidos" name="vencidos">
        <option value="">Todos</option>
        <option value="1" <%= filtros.vencidos ? 'selected' : '' %>>Só vencidos</option>
      </select>
    </div>
    <span class="espaco"></span>
    <button type="submit" class="btn">Filtrar</button>
    <a href="/financeiro/<%= segmento %>" class="btn">Limpar</a>
  </form>

  <% if (!lista.length) { %>
    <div class="vazio">
      <span class="icone">▦</span>
      <p>Nenhum título encontrado.</p>
    </div>
  <% } else { %>
    <div class="tabela-area">
      <table class="tabela responsiva">
        <thead>
          <tr>
            <th>Título</th><th>Descrição</th><th><%= ehPagar ? 'Beneficiário' : 'Pagador' %></th>
            <th>Origem</th><th>Vencimento</th>
            <th class="num">Valor</th><th class="num">Saldo</th><th>Situação</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const t of lista) { %>
            <tr class="<%= t.status === 'CANCELADO' ? 'linha-cancelada' : (t.vencido ? 'linha-alerta' : '') %>">
              <td data-rot="Título" class="doc">
                <a href="/financeiro/<%= segmento %>/<%= t.id %>"><%= t.numero %></a>
              </td>
              <td data-rot="Descrição"><%= t.descricao %>
                <% if (t.categoria) { %><div class="txt-min txt-fraco"><%= t.categoria %></div><% } %>
              </td>
              <td data-rot="<%= ehPagar ? 'Beneficiário' : 'Pagador' %>">
                <%= t.parceiro || t.beneficiario || t.pagador || '—' %>
              </td>
              <td data-rot="Origem" class="txt-min">
                <% if (t.origem !== 'MANUAL') { %>
                  <span class="pill neutro"><%= t.origem %></span>
                  <% if (t.origem_numero) { %><div class="mono txt-fraco"><%= t.origem_numero %></div><% } %>
                <% } else { %><span class="txt-fraco">manual</span><% } %>
              </td>
              <td data-rot="Vencimento" class="nowrap <%= t.vencido ? 'txt-erro txt-forte' : '' %>">
                <%= f.data(t.vencimento) %>
                <% if (t.vencido) { %>
                  <div class="txt-min"><%= f.diasVencidos(t.vencimento) %> dia(s)</div>
                <% } %>
              </td>
              <td data-rot="Valor" class="num"><%= t.moeda_simbolo %> <%= f.formatar(t.valor, 2) %></td>
              <td data-rot="Saldo" class="num txt-forte"><%= t.moeda_simbolo %> <%= f.formatar(t.saldo, 2) %></td>
              <td data-rot="Situação">
                <span class="pill <%= f.classeStatus(t.status) %>"><%= f.rotuloStatus(t.status) %></span>
              </td>
              <td class="acoes">
                <a href="/financeiro/<%= segmento %>/<%= t.id %>" class="btn pequeno">Abrir</a>
              </td>
            </tr>
          <% } %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="5">Total</td>
            <td class="num">R$ <%= f.formatar(totais.total, 2) %></td>
            <td class="num">R$ <%= f.formatar(totais.saldo, 2) %></td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/fim') %>
