<%- include('partials/topo') %>

<%
  const hora = new Date().getHours();
  const cumprimento = hora < 12 ? 'Bom dia' : hora < 18 ? 'Boa tarde' : 'Boa noite';
  const primeiroNome = usuario.nome.split(' ')[0];

  // As seis etapas da operação, na ordem em que acontecem de verdade.
  // O número não é enfeite: é a sequência que o sistema obriga a seguir.
  const etapas = [
    { n: 1, url: '/compras/novo',       ic: 'compras',      cor: 'var(--roxo-500)',
      titulo: 'Comprar',   apoio: 'Pedido ao fornecedor',        perm: 'compras.criar' },
    { n: 2, url: '/recebimentos/novo',  ic: 'recebimento',  cor: 'var(--azul-500)',
      titulo: 'Receber',   apoio: 'Entrada no armazém',          perm: 'compras.criar' },
    { n: 3, url: '/fumigacao/novo',     ic: 'fumigacao',    cor: 'var(--azul-cinza)',
      titulo: 'Fumigar',   apoio: 'Expurgo do lote',             perm: 'fumigacao.criar' },
    { n: 4, url: '/certificados/novo',  ic: 'certificado',  cor: 'var(--marca-500)',
      titulo: 'Certificar', apoio: 'Certificado de fumigação',   perm: 'certificados.criar' },
    { n: 5, url: '/vendas/novo',        ic: 'vendas',       cor: 'var(--ambar-500)',
      titulo: 'Vender',    apoio: 'Pedido do cliente',           perm: 'vendas.criar' },
    { n: 6, url: '/carregamentos/novo', ic: 'carregamento', cor: 'var(--marca-600)',
      titulo: 'Carregar',  apoio: 'Expedição e baixa',           perm: 'carregamento.criar' },
  ].filter((e) => pode(e.perm));

  // Pendências: só entra na lista o que realmente está travando alguém.
  const pendencias = [];
  if (vencidos.length) pendencias.push({
    url: '/financeiro/pagar?status=ABERTO', ic: 'atencao', cor: 'var(--vermelho-500)',
    titulo: `${vencidos.length} título(s) vencido(s)`,
    apoio: `R$ ${f.formatar(financeiro.pagar_vencido, 2)} em atraso`,
  });
  if (semComunicado.length) pendencias.push({
    url: '/fumigacao', ic: 'fumigacao', cor: 'var(--ambar-500)',
    titulo: `${semComunicado.length} fumigação(ões) sem Comunicado`,
    apoio: 'Sem o número do Comunicado não sai certificado',
  });
  if (certificadosRascunho.length) pendencias.push({
    url: '/certificados?status=RASCUNHO', ic: 'certificado', cor: 'var(--ambar-500)',
    titulo: `${certificadosRascunho.length} certificado(s) a validar`,
    apoio: 'Validar consome o saldo fumigado e gera o título',
  });
  if (comercial.recebimentos_pendentes) pendencias.push({
    url: '/recebimentos?status=RASCUNHO', ic: 'recebimento', cor: 'var(--azul-500)',
    titulo: `${comercial.recebimentos_pendentes} recebimento(s) a confirmar`,
    apoio: 'Lançados, mas ainda fora do estoque',
  });
  if (comercial.compras_aguardando + comercial.vendas_aguardando) pendencias.push({
    url: comercial.compras_aguardando ? '/compras?status=AGUARDANDO_APROVACAO' : '/vendas?status=AGUARDANDO_APROVACAO',
    ic: 'documento', cor: 'var(--roxo-500)',
    titulo: `${comercial.compras_aguardando + comercial.vendas_aguardando} pedido(s) aguardando aprovação`,
    apoio: 'Nada acontece com eles até alguém aprovar',
  });
  if (carregamentosAbertos.length) pendencias.push({
    url: '/carregamentos', ic: 'carregamento', cor: 'var(--azul-500)',
    titulo: `${carregamentosAbertos.length} carregamento(s) em aberto`,
    apoio: 'Programados e ainda não expedidos',
  });
  if (estoqueBaixo.length) pendencias.push({
    url: '/estoque', ic: 'estoque', cor: 'var(--ambar-500)',
    titulo: `${estoqueBaixo.length} produto(s) abaixo do mínimo`,
    apoio: 'Estoque disponível menor que o mínimo cadastrado',
  });
%>

<!-- ------------------------------------------------------------ saudação -->
<div class="saudacao mb-2">
  <h2><%= cumprimento %>, <%= primeiroNome %>.</h2>
  <p>
    <% if (pendencias.length) { %>
      Há <strong><%= pendencias.length %></strong> ponto(s) pedindo sua atenção hoje.
    <% } else { %>
      Nada travado. Escolha por onde começar.
    <% } %>
  </p>
</div>

<!-- ------------------------------------------------------ primeiros passos -->
<% if (!primeirosPassos.completo) { %>
  <div class="cartao">
    <div class="cartao-topo">
      <h2>Primeiros passos</h2>
      <span class="sub"><%= primeirosPassos.feitos %> de <%= primeirosPassos.total %> concluídos</span>
      <span class="pill <%= primeirosPassos.percentual > 60 ? 'ok' : 'atencao' %>">
        <%= primeirosPassos.percentual %>%
      </span>
    </div>
    <div class="cartao-corpo">
      <div class="barra mb-2" style="height:10px">
        <div class="parte" data-largura="<%= primeirosPassos.percentual %>%"></div>
      </div>
      <ul class="tarefas">
        <% for (const p of primeirosPassos.passos) { %>
          <li class="<%= p.feito ? 'feita' : '' %>">
            <span class="marca-passo"><%= p.feito ? '✓' : '' %></span>
            <span class="titulo">
              <span class="nome"><%= p.titulo %></span>
              <div class="apoio"><%= p.apoio %></div>
            </span>
            <% if (!p.feito) { %>
              <a href="<%= p.url %>" class="btn pequeno primario"><%= p.acao %></a>
            <% } %>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
<% } %>

<!-- --------------------------------------------------------- o que fazer -->
<% if (etapas.length) { %>
  <div class="secao-titulo">O que você vai fazer agora</div>
  <div class="acoes-rapidas mb-2">
    <% for (const e of etapas) { %>
      <a class="acao" href="<%= e.url %>" style="--cor: <%= e.cor %>">
        <span class="passo"><%= e.n %></span>
        <span class="simbolo"><%- ic(e.ic) %></span>
        <strong><%= e.titulo %></strong>
        <span><%= e.apoio %></span>
      </a>
    <% } %>
  </div>
<% } %>

<!-- ------------------------------------------------------------ pendências -->
<% if (pendencias.length) { %>
  <div class="secao-titulo">Precisa de atenção</div>
  <div class="pendencias mb-2">
    <% for (const p of pendencias) { %>
      <a class="pendencia" href="<%= p.url %>" style="--cor: <%= p.cor %>">
        <span class="simbolo"><%- ic(p.ic) %></span>
        <span class="texto">
          <strong><%= p.titulo %></strong>
          <span><%= p.apoio %></span>
        </span>
        <%- ic('avancar', 'seta') %>
      </a>
    <% } %>
  </div>
<% } %>

<!-- ------------------------------------------------------- como está hoje -->
<div class="secao-titulo">Como está hoje</div>
<div class="grade grade-4 mb-2">
  <a class="indicador destaque" href="/estoque">
    <div class="rotulo">No armazém</div>
    <div class="valor"><%= f.toneladas(estoque.fisico_kg) %></div>
    <div class="apoio"><%= f.toneladas(estoque.disponivel_kg) %> livres para vender</div>
  </a>
  <a class="indicador" href="/fumigacao">
    <div class="rotulo">Fumigado sem certificar</div>
    <div class="valor"><%= f.toneladas(fumigado.saldo_kg) %></div>
    <div class="apoio">pronto para virar certificado</div>
  </a>
  <a class="indicador <%= Number(financeiro.pagar_vencido) > 0 ? 'alerta' : '' %>" href="/financeiro/pagar">
    <div class="rotulo">A pagar</div>
    <div class="valor">R$ <%= f.formatar(financeiro.pagar, 2) %></div>
    <div class="apoio">
      <%= Number(financeiro.pagar_vencido) > 0
            ? 'R$ ' + f.formatar(financeiro.pagar_vencido, 2) + ' vencido'
            : 'nenhum título vencido' %>
    </div>
  </a>
  <a class="indicador" href="/financeiro/receber">
    <div class="rotulo">A receber</div>
    <div class="valor">R$ <%= f.formatar(financeiro.receber, 2) %></div>
    <div class="apoio">
      <%= Number(financeiro.receber_vencido) > 0
            ? 'R$ ' + f.formatar(financeiro.receber_vencido, 2) + ' em atraso'
            : 'em dia' %>
    </div>
  </a>
</div>

<% if (Number(comercial.a_receber_kg) > 0 || Number(comercial.a_embarcar_kg) > 0 || Number(exportacao.kg) > 0) { %>
  <div class="grade grade-3 mb-2">
    <a class="indicador" href="/compras?status=APROVADO">
      <div class="rotulo">Comprado, falta chegar</div>
      <div class="valor"><%= f.toneladas(comercial.a_receber_kg) %></div>
      <div class="apoio">saldo em aberto com fornecedores</div>
    </a>
    <a class="indicador" href="/vendas?status=APROVADO">
      <div class="rotulo">Vendido, falta embarcar</div>
      <div class="valor"><%= f.toneladas(comercial.a_embarcar_kg) %></div>
      <div class="apoio">reservado para clientes</div>
    </a>
    <a class="indicador" href="/carregamentos?status=EXPEDIDO&de=<%= de %>&ate=<%= ate %>">
      <div class="rotulo">Expedido no período</div>
      <div class="valor"><%= f.toneladas(exportacao.kg) %></div>
      <div class="apoio"><%= exportacao.operacoes %> carregamento(s)</div>
    </a>
  </div>
<% } %>

<details class="cartao nao-imprimir" style="margin-top:22px">
  <summary style="padding:16px 20px;cursor:pointer;font-weight:700;font-size:0.95rem">
    Ver números detalhados do período
  </summary>
  <div class="cartao-corpo" style="border-top:1px solid var(--linha)">
    <form method="get" class="barra-acoes mb-2">
      <div class="campo" style="width:180px">
        <label for="de">Período de</label>
        <input type="date" id="de" name="de" value="<%= de %>">
      </div>
      <div class="campo" style="width:180px">
        <label for="ate">até</label>
        <input type="date" id="ate" name="ate" value="<%= ate %>">
      </div>
      <button type="submit" class="btn" style="align-self:flex-end">Atualizar</button>
    </form>

    <div class="grade grade-4">
      <div class="indicador">
        <div class="rotulo">Reservado</div>
        <div class="valor"><%= f.toneladas(estoque.reservado_kg) %></div>
        <div class="apoio">comprometido em pedidos e ordens</div>
      </div>
      <div class="indicador">
        <div class="rotulo">Total já fumigado</div>
        <div class="valor"><%= f.toneladas(fumigado.total_kg) %></div>
        <div class="apoio"><%= fumigado.lotes %> fumigação(ões) validada(s)</div>
      </div>
      <div class="indicador">
        <div class="rotulo">Custo de fumigação</div>
        <div class="valor">R$ <%= f.formatar(custoFumigacao.valor, 2) %></div>
        <div class="apoio"><%= f.toneladas(custoFumigacao.kg) %> certificadas</div>
      </div>
      <div class="indicador <%= Number(resultado.receitas) - Number(resultado.despesas) < 0 ? 'atencao' : 'destaque' %>">
        <div class="rotulo">Resultado do período</div>
        <div class="valor">
          <%= Number(resultado.receitas) - Number(resultado.despesas) < 0 ? '−' : '' %>R$
          <%= f.formatar(Math.abs(Number(resultado.receitas) - Number(resultado.despesas)), 2) %>
        </div>
        <div class="apoio">receitas − despesas lançadas</div>
      </div>
    </div>

    <% if (saldosContas.length) { %>
      <div class="tabela-area mt-2">
        <table class="tabela">
          <thead><tr><th>Conta</th><th>Tipo</th><th class="num">Saldo</th></tr></thead>
          <tbody>
            <% for (const c of saldosContas) { %>
              <tr>
                <td><a href="/financeiro/contas/<%= c.id %>"><%= c.nome %></a></td>
                <td class="txt-min txt-fraco"><%= c.tipo %></td>
                <td class="num txt-forte <%= Number(c.saldo) < 0 ? 'txt-erro' : '' %>">
                  <%= c.moeda_simbolo %> <%= f.formatar(c.saldo, 2) %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>

    <p class="txt-min txt-fraco mt-2 mb-0">
      Relatórios completos, com exportação para planilha, em
      <a href="/relatorios">Relatórios e ajustes</a>.
    </p>
  </div>
</details>

<%- include('partials/fim') %>
