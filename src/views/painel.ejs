<%- include('partials/topo') %>

<%
  const pendencias = [];
  if (vencidos.length) pendencias.push({
    url: '/financeiro/pagar?status=ABERTO', ic: 'atencao', cor: 'var(--vermelho-500)',
    titulo: `${vencidos.length} título(s) vencido(s)`,
    apoio: `R$ ${f.formatar(financeiro.pagar_vencido, 2)} em atraso`,
  });
  if (semComunicado.length) pendencias.push({
    url: '/fumigacao', ic: 'fumigacao', cor: 'var(--ambar-500)',
    titulo: `${semComunicado.length} fumigação(ões) sem Comunicado`,
    apoio: 'Sem o número do Comunicado não sai certificado',
  });
  if (certificadosRascunho.length) pendencias.push({
    url: '/certificados?status=RASCUNHO', ic: 'certificado', cor: 'var(--ambar-500)',
    titulo: `${certificadosRascunho.length} certificado(s) a validar`,
    apoio: 'Validar consome o saldo fumigado e gera o título',
  });
  if (comercial.recebimentos_pendentes) pendencias.push({
    url: '/recebimentos?status=RASCUNHO', ic: 'recebimento', cor: 'var(--azul-500)',
    titulo: `${comercial.recebimentos_pendentes} recebimento(s) a confirmar`,
    apoio: 'Lançados, mas a mercadoria ainda não entrou no estoque',
  });
  if (comercial.compras_aguardando + comercial.vendas_aguardando) pendencias.push({
    url: comercial.compras_aguardando ? '/compras?status=AGUARDANDO_APROVACAO' : '/vendas?status=AGUARDANDO_APROVACAO',
    ic: 'documento', cor: 'var(--roxo-500)',
    titulo: `${comercial.compras_aguardando + comercial.vendas_aguardando} pedido(s) aguardando aprovação`,
    apoio: 'Nada acontece com eles até alguém aprovar',
  });
  if (carregamentosAbertos.length) pendencias.push({
    url: '/carregamentos', ic: 'carregamento', cor: 'var(--azul-500)',
    titulo: `${carregamentosAbertos.length} carregamento(s) em aberto`,
    apoio: 'Programados e ainda não expedidos',
  });
  if (estoqueBaixo.length) pendencias.push({
    url: '/estoque', ic: 'estoque', cor: 'var(--ambar-500)',
    titulo: `${estoqueBaixo.length} produto(s) abaixo do mínimo`,
    apoio: 'Estoque disponível menor que o mínimo cadastrado',
  });
%>

<div class="cabecalho-pagina">
  <div>
    <h1>Panorama do grupo</h1>
    <div class="apoio">O que entrou e o que saiu, de cada operação, no período escolhido.</div>
  </div>
  <span class="espaco"></span>
  <div class="txt-min txt-fraco nowrap"><%= f.data(de) %> a <%= f.data(ate) %></div>
</div>

<!-- ------------------------------------------------------------- período -->
<div class="periodo nao-imprimir">
  <div class="atalhos">
    <% for (const a of atalhosPeriodo) { %>
      <a href="?de=<%= a.de %>&ate=<%= a.ate %>" class="<%= a.ativo ? 'ativo' : '' %>"><%= a.nome %></a>
    <% } %>
  </div>
  <form method="get">
    <input type="date" name="de" value="<%= de %>" aria-label="Data inicial">
    <span class="txt-fraco txt-min">até</span>
    <input type="date" name="ate" value="<%= ate %>" aria-label="Data final">
    <button type="submit" class="btn"><%- ic('buscar') %> Ver</button>
  </form>
</div>

<!-- --------------------------------------------------- panorama por operação -->
<div class="panorama mb-2">
  <% for (const op of panorama.operacoes) { %>
    <section class="operacao" style="--cor: <%= op.cor || 'var(--marca-500)' %>">
      <header>
        <span class="selo"></span>
        <h2><%= op.nome %></h2>
        <span class="tipo"><%= op.tipo === 'GRAOS' ? 'Grão' : op.tipo === 'TRANSPORTE' ? 'Frete' : 'Outra' %></span>
      </header>

      <% if (op.tipo === 'GRAOS') { %>
        <div class="faixa-secao">Mercadoria no período</div>
        <div class="fluxo">
          <div class="lado entra">
            <div class="rotulo"><%- ic('receber') %> Entrou</div>
            <div class="numero"><%= f.toneladas(op.mercadoria.entrou_kg) %></div>
            <div class="apoio"><%= op.mercadoria.entradas %> recebimento(s) confirmado(s)</div>
          </div>
          <div class="divisor-v"></div>
          <div class="lado sai">
            <div class="rotulo"><%- ic('pagar') %> Saiu</div>
            <div class="numero"><%= f.toneladas(op.mercadoria.saiu_kg) %></div>
            <div class="apoio"><%= op.mercadoria.saidas %> carregamento(s) expedido(s)</div>
          </div>
        </div>
      <% } %>

      <div class="faixa-secao">Dinheiro que passou pelo caixa</div>
      <div class="fluxo">
        <div class="lado entra">
          <div class="rotulo"><%- ic('receber') %> Recebido</div>
          <div class="numero">R$ <%= f.formatar(op.dinheiro.entrou, 2) %></div>
          <div class="apoio">baixas de contas a receber</div>
        </div>
        <div class="divisor-v"></div>
        <div class="lado sai">
          <div class="rotulo"><%- ic('pagar') %> Pago</div>
          <div class="numero">R$ <%= f.formatar(op.dinheiro.saiu, 2) %></div>
          <div class="apoio">baixas de contas a pagar</div>
        </div>
      </div>

      <div class="resultado-periodo">
        <span class="rot">Resultado de caixa no período</span>
        <span class="val <%= Number(op.dinheiro.resultado) < 0 ? 'negativo' : 'positivo' %>">
          <%= Number(op.dinheiro.resultado) < 0 ? '−' : '' %>R$
          <%= f.formatar(Math.abs(Number(op.dinheiro.resultado)), 2) %>
        </span>
      </div>

      <div class="rodape-op">
        <div class="peca">
          <div class="rot">Ainda a receber</div>
          <div class="val">R$ <%= f.formatar(op.aberto.receber, 2) %></div>
          <% if (Number(op.aberto.receber_vencido) > 0) { %>
            <div class="txt-min txt-erro">R$ <%= f.formatar(op.aberto.receber_vencido, 2) %> vencido</div>
          <% } %>
        </div>
        <div class="peca">
          <div class="rot">Ainda a pagar</div>
          <div class="val <%= Number(op.aberto.pagar_vencido) > 0 ? 'risco' : '' %>">
            R$ <%= f.formatar(op.aberto.pagar, 2) %>
          </div>
          <% if (Number(op.aberto.pagar_vencido) > 0) { %>
            <div class="txt-min txt-erro">R$ <%= f.formatar(op.aberto.pagar_vencido, 2) %> vencido</div>
          <% } %>
        </div>
        <% if (op.estoque) { %>
          <span class="espaco"></span>
          <div class="peca">
            <div class="rot">Hoje no armazém</div>
            <div class="val"><%= f.toneladas(op.estoque.fisico_kg) %></div>
            <div class="txt-min txt-fraco"><%= f.toneladas(op.estoque.disponivel_kg) %> livres</div>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>
</div>

<!-- ------------------------------------------------------------ pendências -->
<% if (pendencias.length) { %>
  <div class="secao-titulo">Precisa de atenção</div>
  <div class="pendencias mb-2">
    <% for (const p of pendencias) { %>
      <a class="pendencia" href="<%= p.url %>" style="--cor: <%= p.cor %>">
        <span class="simbolo"><%- ic(p.ic) %></span>
        <span class="texto">
          <strong><%= p.titulo %></strong>
          <span><%= p.apoio %></span>
        </span>
        <%- ic('avancar', 'seta') %>
      </a>
    <% } %>
  </div>
<% } %>

<!-- ------------------------------------------------------ primeiros passos -->
<% if (!primeirosPassos.completo) { %>
  <div class="cartao">
    <div class="cartao-topo">
      <h2>Primeiros passos</h2>
      <span class="sub"><%= primeirosPassos.feitos %> de <%= primeirosPassos.total %> concluídos</span>
      <span class="espaco" style="flex:1"></span>
      <span class="pill <%= primeirosPassos.percentual > 60 ? 'ok' : 'atencao' %>">
        <%= primeirosPassos.percentual %>%
      </span>
    </div>
    <div class="cartao-corpo">
      <ul class="tarefas">
        <% for (const p of primeirosPassos.passos) { %>
          <li class="<%= p.feito ? 'feita' : '' %>">
            <span class="marca-passo"><%= p.feito ? '✓' : '' %></span>
            <span class="titulo">
              <span class="nome"><%= p.titulo %></span>
              <div class="apoio"><%= p.apoio %></div>
            </span>
            <% if (!p.feito) { %>
              <a href="<%= p.url %>" class="btn pequeno primario"><%= p.acao %></a>
            <% } %>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
<% } %>

<!-- ------------------------------------------------------ extrato do período -->
<div class="cartao">
  <div class="cartao-topo">
    <h2>Tudo que entrou e saiu</h2>
    <span class="sub">no período escolhido, do mais recente para o mais antigo</span>
  </div>

  <% if (!movimento.length) { %>
    <div class="vazio">
      <%- ic('vazio', 'icone') %>
      <p>
        Nenhuma entrada ou saída neste período. Recebimento confirmado,
        carregamento expedido e baixa de título aparecem aqui.
      </p>
      <% if (pode('compras.criar')) { %>
        <a href="/recebimentos/novo" class="btn primario"><%- ic('recebimento') %> Registrar entrada</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="tabela-area">
      <table class="tabela responsiva">
        <thead>
          <tr>
            <th style="width:110px">Data</th>
            <th style="width:150px">Operação</th>
            <th>O que foi</th>
            <th style="width:120px">Documento</th>
            <th style="width:80px">Sentido</th>
            <th class="num" style="width:140px">Mercadoria</th>
            <th class="num" style="width:150px">Dinheiro</th>
          </tr>
        </thead>
        <tbody>
          <% for (const m of movimento) { %>
            <% const entrada = m.sentido === 'ENTRADA'; %>
            <tr>
              <td data-rot="Data"><%= f.data(m.data) %></td>
              <td data-rot="Operação">
                <span class="pill neutro" style="border-left:3px solid <%= m.operacao_cor || 'var(--linha-forte)' %>">
                  <%= m.operacao || 'sem operação' %>
                </span>
              </td>
              <td data-rot="O que foi"><%= rotuloOrigem(m.origem) %></td>
              <td data-rot="Documento" class="doc">
                <a href="<%= caminhoOrigem(m.origem) %><%= m.documento_id %>"><%= m.documento_numero %></a>
              </td>
              <td data-rot="Sentido">
                <span class="sentido <%= entrada ? 'entrada' : 'saida' %>">
                  <%- ic(entrada ? 'receber' : 'pagar') %> <%= entrada ? 'Entrou' : 'Saiu' %>
                </span>
              </td>
              <td data-rot="Mercadoria" class="num">
                <%= m.quantidade_kg ? f.toneladas(m.quantidade_kg) : '—' %>
              </td>
              <td data-rot="Dinheiro" class="num txt-forte">
                <%= m.valor ? 'R$ ' + f.formatar(m.valor, 2) : '—' %>
              </td>
            </tr>
          <% } %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="5" class="txt-dir">Total do período</td>
            <td class="num">
              <span class="txt-ok">+<%= f.toneladas(panorama.total.entrou_kg) %></span><br>
              <span class="txt-atencao">−<%= f.toneladas(panorama.total.saiu_kg) %></span>
            </td>
            <td class="num">
              <span class="txt-ok">+R$ <%= f.formatar(panorama.total.entrou, 2) %></span><br>
              <span class="txt-atencao">−R$ <%= f.formatar(panorama.total.saiu, 2) %></span>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/fim') %>
