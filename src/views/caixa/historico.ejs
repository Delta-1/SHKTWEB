<%- include('../partials/topo') %>
<div class="cabecalho-pagina"><div><h1>Caixa</h1><p class="apoio">Fechamentos anteriores, diferenças e responsáveis.</p></div></div>
<%- include('_abas') %>

<div class="cartao">
  <form method="get" class="filtros">
    <div class="campo"><label for="de">De</label><input type="date" id="de" name="de" value="<%= filtros.de %>"></div>
    <div class="campo"><label for="ate">Até</label><input type="date" id="ate" name="ate" value="<%= filtros.ate %>"></div>
    <div class="campo largo"><label for="conta">Conta</label><select id="conta" name="conta"><option value="">Todas</option><% for (const c of referencias.contas) { %><option value="<%= c.id %>" <%= Number(filtros.contaId)===Number(c.id)?'selected':'' %>><%= c.nome %></option><% } %></select></div>
    <span class="espaco"></span><button class="btn" type="submit">Filtrar</button><a class="btn" href="/caixa/anteriores">Limpar</a>
  </form>
  <% if (!lista.length) { %><div class="vazio"><p>Nenhum caixa fechado neste período.</p></div><% } else { %>
    <div class="tabela-area"><table class="tabela responsiva"><thead><tr><th>Caixa</th><th>Abertura</th><th>Fechamento</th><th>Responsáveis</th><th class="num">Sistema</th><th class="num">Informado</th><th class="num">Diferença</th><th></th></tr></thead><tbody>
      <% for (const c of lista) { %><tr>
        <td data-rot="Caixa"><a href="/caixa/<%= c.id %>" class="mono"><%= c.numero %></a><div class="txt-min txt-fraco"><%= c.conta_nome %></div></td>
        <td data-rot="Abertura" class="nowrap"><%= f.dataHora(c.abertura_em) %></td>
        <td data-rot="Fechamento" class="nowrap"><%= f.dataHora(c.fechamento_em) %></td>
        <td data-rot="Responsáveis" class="txt-min"><%= c.aberto_por %> → <%= c.fechado_por %></td>
        <td data-rot="Sistema" class="num"><%= c.moeda_simbolo %> <%= f.formatar(c.total_sistema,2) %></td>
        <td data-rot="Informado" class="num"><%= c.moeda_simbolo %> <%= f.formatar(c.total_informado,2) %></td>
        <td data-rot="Diferença" class="num txt-forte <%= Number(c.diferenca)===0?'txt-ok':'txt-erro' %>"><%= c.moeda_simbolo %> <%= f.formatar(c.diferenca,2) %></td>
        <td class="acoes"><a href="/caixa/<%= c.id %>" class="btn pequeno">Abrir</a></td>
      </tr><% } %>
    </tbody></table></div>
  <% } %>
</div>
<%- include('../partials/fim') %>
