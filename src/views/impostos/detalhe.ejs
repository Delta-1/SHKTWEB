<%- include('../partials/topo') %>
<div class="cabecalho-pagina"><div><a href="/impostos" class="voltar"><%- ic('voltar') %> Obrigações</a><h1><%= o.descricao %></h1><p><span class="doc"><%= o.numero %></span> · <%= o.tipo %> · <%= o.operacao %></p></div><div class="acoes"><a class="btn" href="/anexos/OBRIGACAO/<%= o.id %>">Guia / documentos</a><span class="pill grande <%= f.classeStatus(o.status) %>"><%= f.rotuloStatus(o.status) %></span></div></div>
<div class="grade grade-3 mb-2"><div class="kpi"><div class="rotulo">Vencimento</div><div class="numero"><%= f.data(o.vencimento) %></div></div><div class="kpi"><div class="rotulo">Valor</div><div class="numero"><%= o.moeda %> <%= f.formatar(o.valor,2) %></div><div class="apoio">Cotação BRL <%= f.formatar(o.taxa_cambio,4) %></div></div><div class="kpi"><div class="rotulo">Financeiro</div><div class="numero"><% if(o.conta_pagar_numero){%><a href="/financeiro/pagar/<%= o.conta_pagar_id %>"><%= o.conta_pagar_numero %></a><%}else{%>—<%}%></div></div></div>
<div class="cartao mb-2"><div class="cartao-topo"><h2>Detalhes</h2></div><div class="cartao-corpo"><dl class="detalhes"><div><dt>Natureza</dt><dd><%= o.natureza %></dd></div><div><dt>Competência</dt><dd><%= f.data(o.competencia) %></dd></div><div><dt>Documento</dt><dd><%= o.documento||'—' %></dd></div><div><dt>Parcela</dt><dd><%= o.parcela %> de <%= o.total_parcelas %></dd></div></dl></div></div>
<% if(o.status==='RASCUNHO'&&pode('impostos.aprovar')){%><form method="post" action="/impostos/<%= o.id %>/aprovar" class="cartao mb-2"><div class="cartao-topo"><h2>Próximo passo</h2></div><div class="cartao-corpo"><p>Confira os dados. A aprovação gera o Contas a Pagar com o mesmo vencimento.</p><button class="btn primario grande" data-confirmar="Aprovar e gerar o título?">Aprovar obrigação</button></div></form><%}%>
<% if(o.status!=='CANCELADA'&&pode('impostos.cancelar')){%><div class="zona-perigo"><form method="post" action="/impostos/<%= o.id %>/cancelar" class="linha"><input name="motivo" required minlength="5" placeholder="Motivo do cancelamento"><button class="btn perigo" data-confirmar="Cancelar sem apagar o histórico?">Cancelar obrigação</button></form></div><%}%>
<%- include('../partials/fim') %>
