<%- include('../partials/topo') %>
<div class="cabecalho-pagina"><div><h1>Impostos e obrigações</h1><p>Agenda de vencimentos fiscais, operacionais, trabalhistas e de exportação.</p></div><% if(pode('impostos.criar')){%><a class="btn primario grande" href="/impostos/nova">+ Nova obrigação</a><%}%></div>
<div class="cartao"><div class="cartao-topo"><h2>Agenda</h2></div><% if(!lista.length){%><div class="vazio"><p>Nenhuma obrigação cadastrada.</p></div><%}else{%><div class="tabela-area"><table class="tabela responsiva"><thead><tr><th>Vencimento</th><th>Nº</th><th>Tipo</th><th>Descrição</th><th class="num">Valor</th><th>Financeiro</th><th>Situação</th></tr></thead><tbody><% for(const x of lista){%><tr><td><%= f.data(x.vencimento) %></td><td class="doc"><a href="/impostos/<%= x.id %>"><%= x.numero %></a></td><td><%= x.tipo %><div class="txt-min txt-fraco"><%= x.natureza %></div></td><td><%= x.descricao %></td><td class="num"><%= x.moeda %> <%= f.formatar(x.valor,2) %></td><td><%= x.conta_pagar_numero||'—' %></td><td><span class="pill <%= f.classeStatus(x.status) %>"><%= f.rotuloStatus(x.status) %></span></td></tr><%}%></tbody></table></div><%}%></div>
<%- include('../partials/fim') %>
