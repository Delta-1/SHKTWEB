<%- include('../partials/topo') %>
<form method="post" action="/impostos/nova" class="cartao" style="max-width:980px"><div class="cartao-topo"><a href="/impostos" class="btn pequeno"><%- ic('voltar') %> Voltar</a><h2>Nova obrigação</h2></div><div class="cartao-corpo"><div class="campos">
<div class="campo c4"><label>Tipo</label><select name="tipo_id" required><% for(const x of tipos){%><option value="<%= x.id %>"><%= x.natureza %> · <%= x.nome %></option><%}%></select></div><div class="campo c4"><label>Operação</label><select name="operacao_id" required><% for(const x of ref.operacoes){%><option value="<%= x.id %>"><%= x.nome %></option><%}%></select></div><div class="campo c4"><label>Descrição</label><input name="descricao" required maxlength="200"></div>
<div class="campo c3"><label>Competência</label><input type="date" name="competencia" value="<%= hoje.slice(0,7) %>-01" required></div><div class="campo c3"><label>Vencimento</label><input type="date" name="vencimento" value="<%= hoje %>" required></div><div class="campo c3"><label>Documento / guia</label><input name="documento"></div><div class="campo c1"><label>Parcela</label><input type="number" min="1" name="parcela" value="1"></div><div class="campo c2"><label>De</label><input type="number" min="1" name="total_parcelas" value="1"></div>
<div class="campo c3"><label>Valor</label><input name="valor" class="numerico" inputmode="decimal" data-casas="2" required></div><div class="campo c2"><label>Moeda</label><select name="moeda_id"><% for(const x of ref.moedas){%><option value="<%= x.id %>" <%= x.codigo==='BRL'?'selected':'' %>><%= x.codigo %></option><%}%></select></div><div class="campo c3"><label>Cotação em BRL</label><input name="taxa_cambio" value="1,00000000" class="numerico" data-casas="8" required></div><div class="campo c4"><label>Centro de custo</label><select name="centro_custo_id"><option value="">—</option><% for(const x of ref.centrosCusto){%><option value="<%= x.id %>"><%= x.nome %></option><%}%></select></div>
<div class="campo c12"><label>Observações</label><textarea name="observacoes" rows="2"></textarea></div></div></div><div class="rodape-form"><a href="/impostos" class="btn">Cancelar</a><span class="espaco"></span><button class="btn primario grande">Salvar obrigação</button></div></form>
<%- include('../partials/fim') %>
