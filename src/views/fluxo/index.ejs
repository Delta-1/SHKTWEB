<%- include('../partials/topo') %>
<header class="pagina-cabecalho"><div><p class="sobrelinha">SHKT · CENTRAL DE OPERAÇÕES</p><h1>Uma etapa de cada vez.</h1><p class="explica">Escolha onde continuar. Os dados confirmados alimentam as próximas etapas da operação.</p></div><a href="/documentos" class="btn">Meus arquivos</a></header>
<div class="fluxo-colunas"><div class="fluxo-passos">
<% etapas.forEach((e,i)=>{ %>
<section class="fluxo-passo"><div class="fluxo-numero"><%= i+1 %></div><div><h2><%= e.titulo %></h2><p><%= e.descricao %></p><div class="mt-1"><span class="pill"><%= e.status %></span></div></div>
<div class="fluxo-botoes"><a class="btn primario pequeno" href="<%= e.url %>"><%= e.acao %></a><% if(e.novo&&e.criar){ %><a class="btn pequeno" href="<%= e.novo %>">Novo</a><% } %><% if(e.extra){ %><a class="btn pequeno" href="<%= e.extra[1] %>"><%= e.extra[0] %></a><% } %></div></section>
<% }); %>
</div><aside>
<section class="cartao"><div class="cartao-topo"><h2>Continuar depois</h2></div><div class="cartao-corpo"><p class="txt-fraco">Os formulários são salvos automaticamente enquanto você preenche.</p>
<% if(!rascunhos.length){ %><p>Nenhum rascunho pendente.</p><% } %>
<% for(const r of rascunhos){ const segura=typeof r.url==='string'&&/^\/(compras|vendas|recebimentos|fumigacao|certificados|carregamentos|frota|financeiro|rh|impostos|cadastros)\/[a-zA-Z0-9/_-]+(?:\?[a-zA-Z0-9_=&%-]*)?$/.test(r.url); %>
<% if(segura){ %><a class="fluxo-pendencia" href="<%= r.url %>"><span><strong><%= (r.titulo||r.chave).replace(' · SHKT','') %></strong><small class="bloco txt-fraco"><%= f.dataHora(r.atualizado_em) %></small></span><span>Continuar →</span></a><% } %>
<% } %></div></section>
<section class="cartao"><div class="cartao-topo"><h2>Gestão e apoio</h2></div><div class="cartao-corpo"><% for(const a of adicionais){ %><a class="fluxo-pendencia" href="<%= a.url %>"><span><strong><%= a.titulo %></strong><small class="bloco txt-fraco"><%= a.descricao %></small></span><span>→</span></a><% } %></div></section>
<a class="btn" href="/">Abrir painel gerencial</a>
</aside></div>
<%- include('../partials/fim') %>
