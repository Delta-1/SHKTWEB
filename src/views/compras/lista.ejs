<%- include('../partials/topo') %>

<div class="grade grade-2 mb-2">
  <div class="indicador destaque">
    <div class="rotulo"><%- ic('compras') %> Pedidos no filtro</div>
    <div class="valor"><%= totais.quantidade %></div>
    <div class="apoio">rascunhos e cancelados fora da contagem</div>
  </div>
  <div class="indicador">
    <div class="rotulo">Valor comprometido</div>
    <div class="valor">R$ <%= f.formatar(totais.valor, 2) %></div>
    <div class="apoio">soma dos pedidos válidos</div>
  </div>
</div>

<div class="cartao">
  <div class="cartao-topo">
    <h2>Pedidos de compra</h2>
    <span class="sub">O pedido não move estoque — quem move é o recebimento.</span>
    <span style="flex:1"></span>
    <% if (pode('compras.criar')) { %>
      <a href="/compras/novo" class="btn primario pequeno"><%- ic('mais') %> Novo pedido</a>
    <% } %>
  </div>

  <form method="get" class="filtros">
    <div class="campo largo">
      <label for="busca">Buscar</label>
      <input type="search" id="busca" name="busca" value="<%= filtros.busca || '' %>"
             placeholder="Nº do pedido ou fornecedor">
    </div>
    <div class="campo">
      <label for="status">Situação</label>
      <select id="status" name="status">
        <option value="">Todas</option>
        <% for (const s of ['RASCUNHO','AGUARDANDO_APROVACAO','APROVADO','PARCIALMENTE_RECEBIDO','RECEBIDO','CANCELADO']) { %>
          <option value="<%= s %>" <%= filtros.status === s ? 'selected' : '' %>><%= f.rotuloStatus(s) %></option>
        <% } %>
      </select>
    </div>
    <div class="campo">
      <label for="tipo">Tipo</label>
      <select id="tipo" name="tipo">
        <option value="">Todos</option>
        <option value="MERCADORIA" <%= filtros.tipo === 'MERCADORIA' ? 'selected' : '' %>>Mercadoria</option>
        <option value="FRETE" <%= filtros.tipo === 'FRETE' ? 'selected' : '' %>>Frete</option>
        <option value="SERVICO" <%= filtros.tipo === 'SERVICO' ? 'selected' : '' %>>Serviço</option>
      </select>
    </div>
    <div class="campo">
      <label for="fornecedor">Fornecedor</label>
      <select id="fornecedor" name="fornecedor">
        <option value="">Todos</option>
        <% for (const p of ref.fornecedores) { %>
          <option value="<%= p.id %>" <%= String(filtros.fornecedorId) === String(p.id) ? 'selected' : '' %>><%= p.nome %></option>
        <% } %>
      </select>
    </div>
    <div class="campo"><label for="de">De</label>
      <input type="date" id="de" name="de" value="<%= filtros.de || '' %>"></div>
    <div class="campo"><label for="ate">Até</label>
      <input type="date" id="ate" name="ate" value="<%= filtros.ate || '' %>"></div>
    <span class="espaco"></span>
    <button type="submit" class="btn"><%- ic('buscar') %> Filtrar</button>
    <a href="/compras" class="btn">Limpar</a>
  </form>

  <% if (!lista.length) { %>
    <div class="vazio">
      <%- ic('vazio', 'icone') %>
      <p>Nenhum pedido de compra encontrado.</p>
      <% if (pode('compras.criar')) { %>
        <a href="/compras/novo" class="btn primario"><%- ic('mais') %> Criar pedido</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="tabela-area">
      <table class="tabela responsiva">
        <thead>
          <tr>
            <th>Nº</th><th>Fornecedor</th><th>Tipo</th>
            <th class="num">Pedido</th><th class="num">Recebido</th>
            <th class="num">Valor</th><th>Entrega</th><th>Situação</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const p of lista) { %>
            <tr class="<%= p.status === 'CANCELADO' ? 'linha-cancelada' : '' %>">
              <td data-rot="Nº" class="doc">
                <a href="/compras/<%= p.id %>"><%= p.numero %></a>
                <div class="txt-min txt-fraco"><%= f.data(p.data) %></div>
              </td>
              <td data-rot="Fornecedor"><%= p.fornecedor %></td>
              <td data-rot="Tipo" class="txt-min"><%= p.tipo === 'MERCADORIA' ? 'Mercadoria' : p.tipo === 'FRETE' ? 'Frete' : 'Serviço' %></td>
              <td data-rot="Pedido" class="num"><%= f.toneladas(p.pedido_kg) %></td>
              <td data-rot="Recebido" class="num">
                <%= f.toneladas(p.recebido_kg) %>
                <% if (Number(p.pedido_kg) > 0) { %>
                  <div class="barra nao-imprimir">
                    <div class="parte<%= Number(p.recebido_kg) >= Number(p.pedido_kg) ? '' : ' cheio' %>"
                         data-largura="<%= Math.min(100, Math.round((Number(p.recebido_kg) / Number(p.pedido_kg)) * 100)) %>%"></div>
                  </div>
                <% } %>
              </td>
              <td data-rot="Valor" class="num txt-forte"><%= p.moeda %> <%= f.formatar(p.valor_total, 2) %></td>
              <td data-rot="Entrega" class="txt-min"><%= p.previsao_entrega ? f.data(p.previsao_entrega) : '—' %></td>
              <td data-rot="Situação">
                <span class="pill <%= f.classeStatus(p.status) %>"><%= f.rotuloStatus(p.status) %></span>
              </td>
              <td class="acoes"><a href="/compras/<%= p.id %>" class="btn pequeno">Abrir</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/fim') %>
