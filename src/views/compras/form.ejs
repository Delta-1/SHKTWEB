<%- include('../partials/topo') %>

<% const acao = novo ? '/compras/novo' : `/compras/${pedido.id}/editar`;
   const itens = pedido.lista_itens && pedido.lista_itens.length ? pedido.lista_itens : [null]; %>

<form method="post" action="<%= acao %>" class="cartao" style="max-width:1000px" data-etapas>
  <div class="cartao-topo">
    <a href="<%= novo ? '/compras' : '/compras/' + pedido.id %>" class="btn pequeno"><%- ic('voltar') %> Voltar</a>
    <h2><%= novo ? 'Novo pedido de compra' : 'Editar pedido ' + pedido.numero %></h2>
  </div>

  <div class="cartao-corpo">

    <!-- ================================================ etapa 1: fornecedor -->
    <section class="etapa" data-rotulo="Fornecedor">
      <h3>De quem você está comprando?</h3>
      <p class="explica">
        Este pedido é o combinado com o fornecedor. Ele ainda não coloca nada
        no estoque — isso acontece quando o caminhão chegar.
      </p>

      <div class="campos">
        <div class="campo c8">
          <label for="fornecedor_id">Fornecedor <span class="obrigatorio">*</span></label>
          <select id="fornecedor_id" name="fornecedor_id" required data-foco data-resumo="Fornecedor">
            <option value="">Selecione...</option>
            <% for (const x of ref.fornecedores) { %>
              <option value="<%= x.id %>" <%= String(pedido.fornecedor_id) === String(x.id) ? 'selected' : '' %>><%= x.nome %></option>
            <% } %>
          </select>
          <% if (!ref.fornecedores.length) { %>
            <span class="ajuda txt-atencao">
              Nenhum fornecedor cadastrado ainda.
              <a href="/cadastros/fornecedores/novo">Cadastrar agora</a>.
            </span>
          <% } %>
        </div>
        <div class="campo c4">
          <label for="data">Data do pedido <span class="obrigatorio">*</span></label>
          <input type="date" id="data" name="data" required value="<%= f.dataInput(pedido.data) %>"
                 data-resumo="Data do pedido">
        </div>

        <div class="campo c12">
          <label>O que você está comprando?</label>
          <div class="escolhas">
            <% for (const [v, r, ajuda, icone] of [
                 ['MERCADORIA', 'Mercadoria', 'Grão ou insumo — entra no estoque', 'estoque'],
                 ['FRETE', 'Frete', 'Transporte contratado — não entra no estoque', 'carregamento'],
                 ['SERVICO', 'Serviço', 'Mão de obra, manutenção, análise', 'admin'],
               ]) { %>
              <label class="escolha">
                <input type="radio" name="tipo" value="<%= v %>"
                       <%= (pedido.tipo || 'MERCADORIA') === v ? 'checked' : '' %>>
                <span class="simbolo"><%- ic(icone) %></span>
                <span>
                  <strong><%= r %></strong>
                  <span><%= ajuda %></span>
                </span>
              </label>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================== etapa 2: itens -->
    <section class="etapa" data-rotulo="Itens">
      <h3>O que e quanto</h3>
      <p class="explica">
        Uma linha por item. O total é somado sozinho — você não precisa fazer
        a conta.
      </p>

      <div class="tabela-area">
        <table class="tabela" data-linhas="itens">
          <thead>
            <tr>
              <th style="width:24%">Produto</th>
              <th>Descrição</th>
              <th style="width:13%" class="num">Quantidade</th>
              <th style="width:11%">Unidade</th>
              <th style="width:14%" class="num">Preço unit.</th>
              <th style="width:14%" class="num">Total</th>
              <th style="width:48px"></th>
            </tr>
          </thead>
          <tbody>
            <% for (const it of itens) { %>
              <tr data-linha>
                <td>
                  <select name="item_produto_id" data-item-produto>
                    <option value="">—</option>
                    <% for (const x of ref.produtos) { %>
                      <option value="<%= x.id %>" data-descricao="<%= x.descricao %>"
                              data-unidade="<%= x.unidade_id %>"
                              <%= it && String(it.produto_id) === String(x.id) ? 'selected' : '' %>><%= x.descricao %></option>
                    <% } %>
                  </select>
                </td>
                <td><input type="text" name="item_descricao" maxlength="200"
                           placeholder="O que está sendo comprado"
                           value="<%= it ? it.descricao : '' %>"></td>
                <td><input type="text" inputmode="decimal" class="numerico" data-casas="3"
                           name="item_quantidade" data-item-quantidade placeholder="0,000"
                           value="<%= it && it.quantidade_origem ? f.formatar(it.quantidade_origem, 3) : '' %>"></td>
                <td>
                  <select name="item_unidade_id" data-item-unidade>
                    <% for (const x of ref.unidades) { %>
                      <option value="<%= x.id %>" data-fator="<%= x.fator_kg %>"
                              <%= it && String(it.unidade_id) === String(x.id) ? 'selected' : '' %>><%= x.codigo %></option>
                    <% } %>
                  </select>
                </td>
                <td><input type="text" inputmode="decimal" class="numerico" data-casas="2"
                           name="item_preco" data-item-preco placeholder="0,00"
                           value="<%= it && it.preco_unitario ? f.formatar(it.preco_unitario, 2) : '' %>"></td>
                <td class="num txt-forte" data-item-total>
                  <%= it ? f.formatar(it.valor_total, 2) : '0,00' %>
                </td>
                <td class="acoes">
                  <button type="button" class="btn pequeno contorno-perigo" data-remover-linha
                          title="Remover item"><%- ic('excluir') %></button>
                </td>
              </tr>
            <% } %>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="5" class="txt-dir">Total do pedido</td>
              <td class="num" data-total-linhas>0,00</td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <div class="mt-1">
        <button type="button" class="btn" data-adicionar-linha="itens">
          <%- ic('mais') %> Adicionar mais um item
        </button>
      </div>

      <div class="ajuda-caixa mt-2">
        <%- ic('info') %>
        <div>
          A quantidade pode ser digitada em <strong>toneladas, quilos ou
          sacas</strong>. O sistema converte e guarda tudo em quilos — o preço
          é sempre por unidade escolhida aqui.
        </div>
      </div>
    </section>

    <!-- ================================================= etapa 3: conferir -->
    <section class="etapa" data-rotulo="Conferir">
      <h3>Confira antes de criar</h3>
      <p class="explica">
        Ainda dá para voltar e corrigir qualquer coisa. Depois de
        <strong>aprovado</strong>, preço e quantidade ficam travados.
      </p>

      <dl class="confere mb-2" data-confere></dl>

      <div class="ficha mb-2" style="border-top:1px solid var(--linha);padding-top:16px">
        <div class="item">
          <div class="rot">Total do pedido</div>
          <div class="val grande" data-confere-total>0,00</div>
        </div>
      </div>

      <fieldset>
        <legend>Prazos e entrega</legend>
        <div class="campos">
          <div class="campo c4">
            <label for="local_entrega_id">Local de entrega</label>
            <select id="local_entrega_id" name="local_entrega_id" data-resumo="Local de entrega">
              <option value="">—</option>
              <% for (const x of ref.locais) { %>
                <option value="<%= x.id %>" <%= String(pedido.local_entrega_id) === String(x.id) ? 'selected' : '' %>><%= x.nome %></option>
              <% } %>
            </select>
            <span class="ajuda">Obrigatório para mercadoria.</span>
          </div>
          <div class="campo c4">
            <label for="previsao_entrega">Previsão de entrega</label>
            <input type="date" id="previsao_entrega" name="previsao_entrega"
                   value="<%= f.dataInput(pedido.previsao_entrega) %>">
          </div>
          <div class="campo c4">
            <label for="prazo_dias">Prazo de pagamento (dias)</label>
            <input type="number" id="prazo_dias" name="prazo_dias" min="0" max="3650"
                   placeholder="30" value="<%= pedido.prazo_dias ?? '' %>">
            <span class="ajuda">Vira o vencimento do título a pagar.</span>
          </div>

          <div class="campo c3">
            <label for="moeda">Moeda</label>
            <select id="moeda" name="moeda">
              <% for (const x of ref.moedas) { %>
                <option value="<%= x.codigo %>" <%= (pedido.moeda || 'BRL') === x.codigo ? 'selected' : '' %>><%= x.codigo %></option>
              <% } %>
            </select>
          </div>
          <div class="campo c3">
            <label for="incoterm_id">Incoterm</label>
            <select id="incoterm_id" name="incoterm_id">
              <option value="">—</option>
              <% for (const x of ref.incoterms) { %>
                <option value="<%= x.id %>" <%= String(pedido.incoterm_id) === String(x.id) ? 'selected' : '' %>><%= x.codigo %></option>
              <% } %>
            </select>
          </div>
          <div class="campo c6">
            <label for="condicao_pagamento">Condição de pagamento</label>
            <input type="text" id="condicao_pagamento" name="condicao_pagamento" maxlength="120"
                   placeholder="Ex.: 50% na assinatura, 50% na entrega"
                   value="<%= pedido.condicao_pagamento || '' %>">
          </div>

          <div class="campo c12">
            <label for="observacoes">Observações</label>
            <textarea id="observacoes" name="observacoes" rows="3"
                      placeholder="Combinações, exigências de qualidade, prazos..."><%= pedido.observacoes || '' %></textarea>
          </div>
        </div>
      </fieldset>

      <div class="ajuda-caixa">
        <%- ic('info') %>
        <div>
          O pedido nasce como <strong>rascunho</strong>. Nada acontece com ele
          até você clicar em <strong>Aprovar</strong>, na tela seguinte — é a
          aprovação que gera o título a pagar.
        </div>
      </div>
    </section>
  </div>

  <div class="rodape-form">
    <a href="<%= novo ? '/compras' : '/compras/' + pedido.id %>" class="btn">Cancelar</a>
    <button type="button" class="btn oculto" data-etapa-voltar><%- ic('voltar') %> Voltar</button>
    <span class="espaco"></span>
    <button type="button" class="btn primario grande" data-etapa-avancar>
      Continuar <%- ic('avancar') %>
    </button>
    <button type="submit" class="btn primario grande oculto" data-etapa-gravar>
      <%- ic('ok') %> <%= novo ? 'Criar pedido' : 'Salvar alterações' %>
    </button>
  </div>
</form>

<%- include('../partials/fim') %>
