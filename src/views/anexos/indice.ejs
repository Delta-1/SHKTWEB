<%- include('../partials/topo') %>
<div class="cabecalho-pagina"><div><a href="javascript:history.back()" class="voltar"><%- ic('voltar') %> Voltar ao documento</a><h1>Documentos e comprovantes</h1><p><%= tipo.replaceAll('_',' ') %> <span class="doc"><%= registro.numero||'#'+registro.id %></span></p></div></div>
<form method="post" enctype="multipart/form-data" class="cartao mb-2"><div class="cartao-topo"><h2>Anexar arquivo</h2></div><div class="cartao-corpo"><div class="campos"><div class="campo c6"><label>Arquivo</label><input type="file" name="arquivo" accept=".pdf,.jpg,.jpeg,.png,.webp,.xlsx,.xls,.csv" required><span class="ajuda">PDF, imagem ou planilha.</span></div><div class="campo c4"><label>Descrição</label><input name="descricao" placeholder="Ex.: comprovante de pedágio"></div><div class="campo c2"><label>&nbsp;</label><button class="btn primario">Anexar</button></div></div></div></form>
<div class="cartao"><div class="cartao-topo"><h2>Arquivos anexados</h2></div><% if(!anexos.length){%><div class="vazio"><p>Nenhum arquivo anexado.</p></div><%}else{%><div class="lista-simples"><% for(const a of anexos){%><div class="linha-simples"><div><strong><a href="/anexos/arquivo/<%= tipo %>/<%= a.id %>"><%= a.nome_original %></a></strong><span><%= a.descricao||'Sem descrição' %> · <%= f.dataHora(a.criado_em) %> · <%= a.usuario_nome||'Sistema' %></span></div><span><%= Math.ceil(Number(a.tamanho||0)/1024) %> KB</span><form method="post" action="/anexos/arquivo/<%= tipo %>/<%= a.id %>/excluir" class="linha"><input name="motivo" required minlength="5" placeholder="Motivo"><button class="btn pequeno perigo">Retirar</button></form></div><%}%></div><%}%></div>
<%- include('../partials/fim') %>
