<%- include('../partials/topo') %>
<div class="cabecalho-pagina"><div><h1>Importar planilhas</h1><p>Modelo pronto, prévia com erros e confirmação sem duplicar cadastros.</p></div><% if(pode('importacoes.criar')){%><a href="/importacoes/nova" class="btn primario grande">+ Nova importação</a><%}%></div>
<div class="cartao"><div class="cartao-topo"><h2>Histórico</h2></div><% if(!lista.length){%><div class="vazio"><p>Nenhuma planilha enviada.</p></div><%}else{%><div class="tabela-area"><table class="tabela responsiva"><thead><tr><th>Nº</th><th>Arquivo</th><th>Tipo</th><th>Linhas</th><th>Válidas</th><th>Erros</th><th>Situação</th></tr></thead><tbody><% for(const x of lista){%><tr><td class="doc"><a href="/importacoes/<%= x.id %>"><%= x.numero %></a></td><td><%= x.arquivo_nome %></td><td><%= x.entidade %></td><td><%= x.total_linhas %></td><td><%= x.linhas_validas %></td><td><%= x.linhas_erros %></td><td><span class="pill <%= f.classeStatus(x.status) %>"><%= f.rotuloStatus(x.status) %></span></td></tr><%}%></tbody></table></div><%}%></div>
<%- include('../partials/fim') %>
