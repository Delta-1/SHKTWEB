<%- include('../partials/topo') %>
<div class="cabecalho-pagina"><div><a href="/importacoes" class="voltar"><%- ic('voltar') %> Importações</a><h1>Prévia <span class="doc"><%= imp.numero %></span></h1><p><%= imp.entidade %> · <%= imp.arquivo_nome %></p></div><span class="pill grande <%= f.classeStatus(imp.status) %>"><%= f.rotuloStatus(imp.status) %></span></div>
<div class="grade grade-3 mb-2"><div class="kpi"><div class="rotulo">Linhas</div><div class="numero"><%= imp.total_linhas %></div></div><div class="kpi"><div class="rotulo">Prontas</div><div class="numero"><%= imp.linhas_validas %></div></div><div class="kpi"><div class="rotulo">Com erro</div><div class="numero"><%= imp.linhas_erros %></div></div></div>
<% if(imp.linhas_erros>0){%><div class="aviso erro"><%- ic('erro') %><div><strong>Nada foi importado</strong>Corrija as linhas marcadas na planilha original e envie o arquivo novamente.</div></div><%}else if(imp.status==='PREVIA'){%><div class="aviso ok"><%- ic('ok') %><div><strong>Tudo pronto</strong>Confira a amostra abaixo e confirme para criar os cadastros.</div></div><%}%>
<div class="cartao mb-2"><div class="cartao-topo"><h2>Linhas da planilha</h2></div><div class="tabela-area"><table class="tabela responsiva"><thead><tr><th>Linha</th><th>Dados reconhecidos</th><th>Validação</th></tr></thead><tbody><% for(const x of imp.linhas){%><tr><td><%= x.linha %></td><td><strong><%= x.dados.codigo %></strong> · <%= x.dados.descricao||x.dados.razao_social %><div class="txt-min txt-fraco"><%= x.dados.documento||x.dados.unidade||'' %></div></td><td><% if(x.valido){%><span class="pill sucesso">Pronta</span><%}else{%><span class="pill perigo">Erro</span><div class="txt-min"><%= x.erros.join(' ') %></div><%}%></td></tr><%}%></tbody></table></div></div>
<% if(imp.status==='PREVIA'&&imp.linhas_erros===0&&pode('importacoes.aprovar')){%><form method="post" action="/importacoes/<%= imp.id %>/confirmar" class="cartao"><div class="cartao-corpo"><button class="btn primario grande" data-confirmar="Criar <%= imp.linhas_validas %> cadastro(s) agora?">Confirmar importação</button></div></form><%}%>
<%- include('../partials/fim') %>
