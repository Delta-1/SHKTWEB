<%- include('../partials/topo') %>
<div class="cabecalho-pagina"><div><a href="/rh" class="voltar"><%- ic('voltar') %> Folhas</a><h1>Folha <span class="doc"><%= folha.numero %></span></h1><p><%= f.data(folha.competencia) %> · vencimento <%= f.data(folha.vencimento) %> · <%= folha.operacao %></p></div><div class="acoes"><a class="btn" href="/anexos/FOLHA/<%= folha.id %>">Documentos</a><span class="pill grande <%= f.classeStatus(folha.status) %>"><%= f.rotuloStatus(folha.status) %></span></div></div>
<div class="grade grade-3 mb-2"><div class="kpi"><div class="rotulo">Funcionários</div><div class="numero"><%= folha.itens.length %></div></div><div class="kpi"><div class="rotulo">Proventos</div><div class="numero">R$ <%= f.formatar(folha.itens.reduce((s,x)=>s+Number(x.total_proventos),0),2) %></div></div><div class="kpi"><div class="rotulo">Líquido</div><div class="numero">R$ <%= f.formatar(folha.itens.reduce((s,x)=>s+Number(x.valor_liquido),0),2) %></div></div></div>
<% if(folha.status==='RASCUNHO'&&pode('rh.editar')){%><form method="post" action="/rh/<%= folha.id %>/funcionarios" class="cartao mb-2"><div class="cartao-topo"><h2>1. Incluir ou corrigir funcionário</h2></div><div class="cartao-corpo"><div class="campos">
<div class="campo c4"><label>Funcionário</label><select name="funcionario_id" required><option value="">Selecione</option><% for(const x of ref.funcionarios){%><option value="<%= x.id %>"><%= x.matricula %> · <%= x.nome %></option><%}%></select></div>
<% const campos=[['salario_base','Salário-base'],['horas_extras','Horas extras'],['adicionais','Adicionais'],['comissoes','Comissões'],['outros_proventos','Outros proventos'],['adiantamentos','Adiantamentos'],['inss','INSS'],['outros_descontos','Outros descontos']]; for(const [n,r] of campos){%><div class="campo c2"><label><%= r %></label><input name="<%= n %>" value="0,00" class="numerico" inputmode="decimal" data-casas="2" required></div><%}%>
<div class="campo c8"><label>Observações</label><input name="observacoes"><span class="ajuda">Para corrigir, selecione novamente o mesmo funcionário e informe os valores certos.</span></div><div class="campo c4"><label>&nbsp;</label><button class="btn primario">Salvar na folha</button></div></div></div></form><%}%>
<div class="cartao mb-2"><div class="cartao-topo"><h2>2. Conferência</h2></div><% if(!folha.itens.length){%><div class="vazio compacto"><p>Inclua os funcionários acima.</p></div><%}else{%><div class="tabela-area"><table class="tabela responsiva"><thead><tr><th>Funcionário</th><th class="num">Proventos</th><th class="num">Descontos</th><th class="num">Líquido</th><th>Financeiro</th></tr></thead><tbody><% for(const x of folha.itens){%><tr><td><strong><%= x.funcionario %></strong><div class="txt-min txt-fraco"><%= x.matricula %></div></td><td class="num">R$ <%= f.formatar(x.total_proventos,2) %></td><td class="num">R$ <%= f.formatar(x.total_descontos,2) %></td><td class="num txt-forte">R$ <%= f.formatar(x.valor_liquido,2) %></td><td><% if(x.conta_pagar_numero){%><a href="/financeiro/pagar/<%= x.conta_pagar_id %>"><%= x.conta_pagar_numero %></a><%}else{%>—<%}%></td></tr><%}%></tbody></table></div><%}%></div>
<% if(folha.status==='RASCUNHO'&&pode('rh.aprovar')){%><div class="cartao mb-2"><div class="cartao-topo"><h2>3. Fechar e integrar</h2></div><div class="cartao-corpo"><p>Após conferir, o fechamento gera um Contas a Pagar por funcionário. A folha não poderá mais ser reescrita.</p><form method="post" action="/rh/<%= folha.id %>/fechar"><button class="btn primario grande" data-confirmar="Fechar a folha e gerar os títulos?">Fechar folha</button></form></div></div><%}%>
<% if(folha.status!=='CANCELADA'&&pode('rh.cancelar')){%><div class="zona-perigo"><form method="post" action="/rh/<%= folha.id %>/cancelar" class="linha"><input name="motivo" required minlength="5" placeholder="Motivo do cancelamento"><button class="btn perigo" data-confirmar="Cancelar a folha e seus títulos sem apagar o histórico?">Cancelar folha</button></form></div><%}%>
<%- include('../partials/fim') %>
