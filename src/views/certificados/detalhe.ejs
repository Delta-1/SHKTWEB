<%- include('../partials/topo') %>

<% const c = certificado; %>

<div class="cartao">
  <div class="cartao-topo">
    <a href="/certificados" class="btn pequeno"><%- ic('voltar') %> Lista</a>
    <h2>Certificado <span class="mono"><%= c.numero %></span></h2>
    <span class="pill <%= f.classeStatus(c.status) %>"><%= f.rotuloStatus(c.status) %></span>
    <span style="flex:1"></span>
    <a href="/certificados/<%= c.id %>/documento" class="btn pequeno" target="_blank">Imprimir</a>
    <% if (c.status === 'RASCUNHO' && pode('certificados.editar')) { %>
      <a href="/certificados/<%= c.id %>/editar" class="btn pequeno">Editar</a>
    <% } %>
  </div>

  <div class="cartao-corpo">
    <!-- Rastreabilidade: fumigação → certificado → financeiro → carregamento -->
    <div class="trilha mb-2">
      <span class="elo">
        <span class="rot">Fumigação</span>
        <a href="/fumigacao/<%= c.fumigacao_id %>" class="mono"><%= c.fumigacao_numero %></a>
      </span>
      <span class="seta">→</span>
      <span class="elo">
        <span class="rot">Comunicado</span>
        <span class="mono"><%= c.numero_comunicado || '—' %></span>
      </span>
      <span class="seta">→</span>
      <span class="elo">
        <span class="rot">Certificado</span>
        <span class="mono"><%= c.numero_certificado || c.numero %></span>
      </span>
      <span class="seta">→</span>
      <span class="elo">
        <span class="rot">Contas a pagar</span>
        <% if (c.conta_pagar_numero) { %>
          <a href="/financeiro/pagar/<%= c.conta_pagar_id %>" class="mono"><%= c.conta_pagar_numero %></a>
        <% } else { %><span class="txt-fraco">—</span><% } %>
      </span>
      <% if (c.carregamentos.length) { %>
        <span class="seta">→</span>
        <span class="elo">
          <span class="rot">Carregamento</span>
          <% for (const cg of c.carregamentos) { %>
            <a href="/carregamentos/<%= cg.id %>" class="mono"><%= cg.numero %></a>
          <% } %>
        </span>
      <% } %>
    </div>

    <div class="ficha">
      <div class="item"><div class="rot">Empresa fumigadora</div><div class="val"><%= c.fumigadora %></div></div>
      <div class="item"><div class="rot">Produto</div><div class="val"><%= c.produto %></div></div>
      <div class="item"><div class="rot">Quantidade</div>
        <div class="val grande"><%= f.toneladas(c.quantidade_kg) %></div>
        <div class="txt-min txt-fraco"><%= f.kg(c.quantidade_kg) %></div></div>
      <div class="item"><div class="rot">Custo por tonelada</div>
        <div class="val"><%= c.moeda_simbolo %> <%= f.formatar(c.custo_tonelada, 2) %></div></div>
      <div class="item"><div class="rot">Valor total</div>
        <div class="val grande"><%= c.moeda_simbolo %> <%= f.formatar(c.valor_total, 2) %></div></div>
      <div class="item"><div class="rot">Data</div><div class="val"><%= f.data(c.data) %></div></div>
      <div class="item"><div class="rot">Vencimento</div><div class="val"><%= f.data(c.vencimento) %></div></div>
      <div class="item"><div class="rot">Cliente / destino</div>
        <div class="val"><%= c.cliente || '—' %><% if (c.destino) { %><div class="txt-min txt-fraco"><%= c.destino %></div><% } %></div></div>
    </div>

    <% if (c.observacoes) { %>
      <p class="txt-min txt-fraco mt-2 mb-0"><strong>Observações:</strong> <%= c.observacoes %></p>
    <% } %>

    <% if (c.status === 'VALIDADO') { %>
      <div class="aviso ok mt-2 mb-0">
        <%- ic('ok') %>
        <div>
          <strong>Validado em <%= f.dataHora(c.validado_em) %><%= c.validado_por_nome ? ' por ' + c.validado_por_nome : '' %></strong>
          Saldo fumigado consumido e título financeiro gerado.
        </div>
      </div>
    <% } %>

    <% if (c.status === 'CANCELADO') { %>
      <div class="aviso erro mt-2 mb-0">
        <%- ic('erro') %>
        <div>
          <strong>Cancelado em <%= f.dataHora(c.cancelado_em) %></strong>
          <%= c.motivo_cancelamento %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<!-- ---------------------------------------------------------------- validar -->
<% if (c.status === 'RASCUNHO' && pode('certificados.aprovar')) { %>
  <div class="cartao">
    <div class="cartao-topo"><h2>Validar certificado</h2></div>
    <div class="cartao-corpo">
      <p class="txt-min mb-2">Ao validar, em uma única operação o sistema irá:</p>
      <ol class="txt-min" style="margin:0 0 16px;padding-left:20px;line-height:1.9">
        <li>conferir o saldo fumigado da fumigação <strong class="mono"><%= c.fumigacao_numero %></strong>
            (disponível: <strong><%= f.toneladas(c.fumigacao_saldo_kg) %></strong>);</li>
        <li>baixar <strong><%= f.toneladas(c.quantidade_kg) %></strong> da conta-corrente de fumigação;</li>
        <li>gerar o Contas a Pagar de <strong><%= c.moeda_simbolo %> <%= f.formatar(c.valor_total, 2) %></strong>
            para <strong><%= c.fumigadora %></strong>, com vencimento em
            <strong><%= f.data(c.vencimento) %></strong>;</li>
        <li>registrar tudo na auditoria.</li>
      </ol>

      <% if (!c.numero_certificado) { %>
        <div class="aviso atencao mb-0">
          <%- ic('atencao') %>
          <div>Informe o <strong>número do certificado emitido pela fumigadora</strong> antes de validar.
            <a href="/certificados/<%= c.id %>/editar">Editar certificado</a>.</div>
        </div>
      <% } else if (Number(c.quantidade_kg) > Number(c.fumigacao_saldo_kg)) { %>
        <div class="aviso erro mb-0">
          <%- ic('erro') %>
          <div>A quantidade do certificado é maior que o saldo fumigado disponível.
            Ajuste a quantidade ou valide outra fumigação.</div>
        </div>
      <% } else { %>
        <form method="post" action="/certificados/<%= c.id %>/validar">
          <button type="submit" class="btn primario"
                  data-confirmar="Validar o certificado <%= c.numero %>? Isso consome <%= f.toneladas(c.quantidade_kg) %> do saldo fumigado e gera o título financeiro.">
            Validar e gerar contas a pagar
          </button>
        </form>
      <% } %>
    </div>
  </div>
<% } %>

<!-- ------------------------------------------------------- vínculo financeiro -->
<% if (c.conta_pagar_numero) { %>
  <div class="cartao">
    <div class="cartao-topo">
      <h2>Título financeiro gerado</h2>
      <span class="sub">criado automaticamente por este certificado</span>
    </div>
    <div class="tabela-area">
      <table class="tabela">
        <thead><tr><th>Título</th><th>Beneficiário</th><th>Vencimento</th><th class="num">Valor</th><th>Situação</th><th></th></tr></thead>
        <tbody>
          <tr>
            <td class="doc"><a href="/financeiro/pagar/<%= c.conta_pagar_id %>"><%= c.conta_pagar_numero %></a></td>
            <td><%= c.fumigadora %></td>
            <td><%= f.data(c.conta_pagar_vencimento) %></td>
            <td class="num txt-forte"><%= c.moeda_simbolo %> <%= f.formatar(c.conta_pagar_valor, 2) %></td>
            <td><span class="pill <%= f.classeStatus(c.conta_pagar_status) %>"><%= f.rotuloStatus(c.conta_pagar_status) %></span></td>
            <td class="acoes"><a href="/financeiro/pagar/<%= c.conta_pagar_id %>" class="btn pequeno">Abrir</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<!-- ------------------------------------------------------------ carregamentos -->
<% if (c.carregamentos.length) { %>
  <div class="cartao">
    <div class="cartao-topo"><h2>Carregamentos vinculados</h2></div>
    <div class="tabela-area">
      <table class="tabela">
        <thead><tr><th>Nº</th><th>Data</th><th>Destino</th><th class="num">Quantidade</th><th>Situação</th></tr></thead>
        <tbody>
          <% for (const cg of c.carregamentos) { %>
            <tr>
              <td class="doc"><a href="/carregamentos/<%= cg.id %>"><%= cg.numero %></a></td>
              <td><%= f.data(cg.data) %></td>
              <td><%= cg.destino || '—' %></td>
              <td class="num"><%= f.toneladas(cg.quantidade_kg) %></td>
              <td><span class="pill <%= f.classeStatus(cg.status) %>"><%= f.rotuloStatus(cg.status) %></span></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<!-- --------------------------------------------------------------- cancelar -->
<% if (c.status !== 'CANCELADO' && pode('certificados.cancelar')) { %>
  <div class="barra-acoes mt-2">
    <span class="espaco"></span>
    <button type="button" class="btn contorno-perigo" data-modal="#modal-cancelar">Cancelar certificado</button>
  </div>

  <dialog class="modal" id="modal-cancelar">
    <form method="post" action="/certificados/<%= c.id %>/cancelar">
      <div class="modal-topo"><h2>Cancelar certificado <%= c.numero %></h2></div>
      <div class="modal-corpo">
        <p class="txt-min">
          <% if (c.status === 'VALIDADO') { %>
            O saldo de <strong><%= f.toneladas(c.quantidade_kg) %></strong> volta para a fumigação
            <span class="mono"><%= c.fumigacao_numero %></span>
            <% if (c.conta_pagar_numero) { %>
              e o título <span class="mono"><%= c.conta_pagar_numero %></span> é cancelado.
            <% } %>
          <% } %>
          O certificado permanece no histórico.
        </p>
        <div class="campo">
          <label for="motivo-cancelar">Motivo <span class="obrigatorio">*</span></label>
          <textarea id="motivo-cancelar" name="motivo" rows="3" required minlength="5"></textarea>
        </div>
      </div>
      <div class="modal-rodape">
        <button type="button" class="btn" data-fechar-modal>Voltar</button>
        <button type="submit" class="btn perigo">Confirmar cancelamento</button>
      </div>
    </form>
  </dialog>
<% } %>

<%- include('../partials/fim') %>
