<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f2f4f7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0f141f" media="(prefers-color-scheme: dark)">
  <title><%= titulo %> · ERP SHKT</title>
  <link rel="icon" href="/estatico/img/logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="<%= estatico('css/app.css') %>">
  <link rel="manifest" href="/estatico/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/estatico/img/icone-180.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="ERP SHKT">
  <script>
    /* Aplica o tema antes de pintar a tela. Sem isto, quem usa o modo escuro
       vê um lampejo branco a cada página carregada. */
    (function () {
      try {
        var t = localStorage.getItem('shkt-tema');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'escuro' : 'claro';
        if (t === 'escuro') document.documentElement.classList.add('escuro');
      } catch (e) { /* navegador sem localStorage: fica no tema claro */ }
    })();
  </script>
</head>
<body>
<%- sprite %>
<div class="app">

  <%- include('menu') %>

  <div class="conteudo">
    <main class="pagina">
      <% if (typeof mensagem !== 'undefined' && mensagem) { %>
        <div class="aviso <%= mensagem.tipo || 'ok' %>" data-vira-toast>
          <%- ic(mensagem.tipo === 'erro' ? 'erro' : mensagem.tipo === 'atencao' ? 'atencao' : 'ok') %>
          <div><%= mensagem.texto %></div>
        </div>
      <% } %>
      <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="aviso erro">
          <%- ic('erro') %>
          <div><strong>Operação não realizada</strong><%= erro %></div>
        </div>
      <% } %>
