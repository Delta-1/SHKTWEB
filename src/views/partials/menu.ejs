<%
  // O menu é montado a partir das permissões: o operador só enxerga o que
  // pode usar. A barreira real continua sendo o back-end.
  //
  // Agrupado em poucas seções, e a seção só abre a lista quando é nela que
  // a pessoa está. Vinte links soltos na lateral não é navegação, é ruído.
  const secoes = [
    {
      inicio: true,
      url: '/', ic: 'painel', texto: 'Início', perm: 'dashboard.visualizar',
    },
    {
      chave: 'comprar', ic: 'compras', texto: 'Comprar', perm: 'compras.visualizar',
      marcador: typeof alertaCompras !== 'undefined' ? alertaCompras : 0,
      itens: [
        { url: '/compras', texto: 'Pedidos de compra' },
        { url: '/recebimentos', texto: 'Recebimentos' },
      ],
    },
    {
      chave: 'guardar', ic: 'estoque', texto: 'Armazém', perm: 'estoque.visualizar',
      marcador: typeof alertaFumigacao !== 'undefined' ? alertaFumigacao : 0,
      itens: [
        { url: '/estoque', texto: 'Posição de estoque' },
        { url: '/fumigacao', texto: 'Fumigação', perm: 'fumigacao.visualizar' },
        { url: '/certificados', texto: 'Certificados', perm: 'certificados.visualizar' },
      ],
    },
    {
      chave: 'vender', ic: 'vendas', texto: 'Vender', perm: 'vendas.visualizar',
      marcador: typeof alertaVendas !== 'undefined' ? alertaVendas : 0,
      itens: [
        { url: '/vendas', texto: 'Pedidos de venda' },
        { url: '/carregamentos', texto: 'Carregamentos', perm: 'carregamento.visualizar' },
      ],
    },
    {
      chave: 'dinheiro', ic: 'caixa', texto: 'Dinheiro', perm: 'financeiro.visualizar',
      marcador: typeof alertaVencidos !== 'undefined' ? alertaVencidos : 0,
      itens: [
        { url: '/financeiro/pagar', texto: 'Contas a pagar' },
        { url: '/financeiro/receber', texto: 'Contas a receber' },
        { url: '/financeiro/contas', texto: 'Caixa e bancos' },
      ],
    },
    {
      chave: 'cadastros', ic: 'clientes', texto: 'Cadastros', perm: 'cadastros.visualizar',
      itens: [
        { url: '/cadastros/clientes', texto: 'Clientes' },
        { url: '/cadastros/fornecedores', texto: 'Fornecedores' },
        { url: '/cadastros/produtos', texto: 'Produtos' },
        { url: '/cadastros/lotes', texto: 'Lotes' },
        { url: '/cadastros/fumigadoras', texto: 'Fumigadoras' },
        { url: '/cadastros/transportadoras', texto: 'Transportadoras' },
        { url: '/cadastros/veiculos', texto: 'Veículos' },
        { url: '/cadastros/motoristas', texto: 'Motoristas' },
        { url: '/cadastros/funcionarios', texto: 'Funcionários' },
        { url: '/cadastros', texto: 'Tabelas de apoio', exato: true },
      ],
    },
    {
      chave: 'gestao', ic: 'relatorios', texto: 'Relatórios e ajustes', perm: 'relatorios.visualizar',
      itens: [
        { url: '/relatorios', texto: 'Relatórios' },
        { url: '/auditoria', texto: 'Auditoria', perm: 'auditoria.visualizar' },
        { url: '/admin', texto: 'Usuários e empresa', perm: 'admin.visualizar' },
      ],
    },
  ];

  const itemAtivo = (i) => (i.exato ? caminho === i.url : caminho.startsWith(i.url));
%>
<nav class="menu">
  <% for (const s of secoes) { %>
    <% if (!pode(s.perm)) continue; %>

    <% if (s.inicio) { %>
      <div class="menu-secao">
        <a href="<%= s.url %>" class="menu-cabeca <%= caminho === '/' ? 'ativo' : '' %>">
          <%- ic(s.ic) %><span><%= s.texto %></span>
        </a>
      </div>
    <% } else { %>
      <% const visiveis = s.itens.filter((i) => !i.perm || pode(i.perm)); %>
      <% if (!visiveis.length) continue; %>
      <% const aberta = visiveis.some(itemAtivo); %>
      <div class="menu-secao <%= aberta ? 'aberta' : '' %>">
        <button type="button" class="menu-cabeca" data-secao aria-expanded="<%= aberta %>">
          <%- ic(s.ic) %>
          <span><%= s.texto %></span>
          <% if (s.marcador) { %><span class="marcador"><%= s.marcador %></span><% } %>
          <%- ic('avancar', 'seta') %>
        </button>
        <div class="menu-itens">
          <% for (const i of visiveis) { %>
            <a href="<%= i.url %>" class="<%= itemAtivo(i) ? 'ativo' : '' %>"><%= i.texto %></a>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</nav>
