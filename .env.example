# =====================================================================
# ERP SHKT - configuração de ambiente
# Copie para .env e ajuste. O arquivo .env NUNCA vai para o Git.
# =====================================================================

NODE_ENV=production
PORT=3000

# --------------------------------------------------------------- banco
DATABASE_URL=postgres://shkt:TROQUE_ESTA_SENHA@banco:5432/shkt_erp
# Supabase: copie a "Connection string" do pooler em Project Settings > Database.
# Hosts do Supabase ativam SSL automaticamente; para outros provedores, ajuste aqui.
DATABASE_SSL=false

# Usados pelo docker-compose
DB_USER=shkt
DB_PASSWORD=TROQUE_ESTA_SENHA
DB_NAME=shkt_erp
PORTA=3000

# ------------------------------------------------------------- sessão
# Gere um valor aleatório: openssl rand -base64 48
SESSION_SECRET=TROQUE_POR_UM_SEGREDO_ALEATORIO_LONGO
# true quando o sistema estiver atrás de HTTPS (obrigatório em produção)
SESSION_SECURE=false
# Horas de inatividade até o logout automático
SESSION_HOURS=12

# ---------------------------------------------- primeiro administrador
# Usados apenas na primeira carga (npm run seed)
ADMIN_EMAIL=admin@shkt.com.br
ADMIN_SENHA=troque-no-primeiro-acesso

# ------------------------------------------- dados usados nos documentos
EMPRESA_NOME=SHKT INDÚSTRIA IMPORTAÇÃO & EXPORTAÇÃO LTDA
EMPRESA_NOME_CURTO=SHKT
EMPRESA_CNPJ=
EMPRESA_ENDERECO=
EMPRESA_CIDADE=
EMPRESA_TELEFONE=
EMPRESA_EMAIL=

# ------------------------------------------------------------- regras
# Vencimento padrão do título gerado pelo Certificado de Fumigação
DIAS_VENCIMENTO_CERTIFICADO=10
DIAS_VENCIMENTO_COMPRA=30
DIAS_VENCIMENTO_VENDA=30

# ------------------------------------------------------------- anexos
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=20

# ------------------------------------------------------------ backups
RETENCAO_DIAS=30
